<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <StartupObject>PosterForm</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="poster.jpg">
      <LogicalName>poster.jpg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="daddy.png">
      <LogicalName>daddy.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
